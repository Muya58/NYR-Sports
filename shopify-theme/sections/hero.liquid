<section class="hero" id="top">
  <div class="hero__copy reveal">
    {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
    <h1>{{ section.settings.heading | escape }} <br><span class="grad">{{ section.settings.heading_accent | escape }}</span></h1>
    {%- if section.settings.text != blank %}<p class="lead">{{ section.settings.text }}</p>{% endif -%}
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--lime">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="link-arrow">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="stage reveal">
    <div class="stage__glow"></div>
    <div class="stage__field"></div>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'stage__photo', widths: '800, 1200, 1600, 2400', sizes: '(min-width: 1200px) 1120px, 92vw', loading: 'eager', fetchpriority: 'high' }}
    {%- else -%}
      <div class="lineup" aria-hidden="true">
        <div class="lineup__item lineup__item--l" data-art="tank" data-a="#F2F4F7" data-b="#01144C" data-num="23" data-team="NYR"></div>
        <div class="lineup__item lineup__item--c" data-art="jersey" data-a="#B8FC0B" data-b="#01144C" data-num="10" data-style="soccer"></div>
        <div class="lineup__item lineup__item--r" data-art="jersey" data-a="#0D2470" data-b="#F2F4F7" data-num="7" data-team="Bravos" data-style="baseball"></div>
        <div class="lineup__ball lineup__ball--1" data-art="ball" data-a="basket"></div>
        <div class="lineup__ball lineup__ball--2" data-art="ball" data-a="volley"></div>
        <div class="lineup__ball lineup__ball--3" data-art="ball" data-a="baseball"></div>
      </div>
    {%- endif -%}
    {%- if section.settings.chip_title != blank -%}
      <div class="chip chip--tl glass"><span class="dot"></span><div><b>{{ section.settings.chip_title | escape }}</b><small>{{ section.settings.chip_text | escape }}</small></div></div>
    {%- endif -%}
    {%- if section.settings.chip2_big != blank -%}
      <div class="chip chip--br glass"><b class="big">{{ section.settings.chip2_big | escape }}</b><small>{{ section.settings.chip2_text | escape }}</small></div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="stats reveal">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b><span>{{ block.settings.label | escape }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Portada (hero)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Ropa · Calzado · Equipamiento" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Vistiendo equipos." },
    { "type": "text", "id": "heading_accent", "label": "Titular (segunda línea, degradado)", "default": "En cada deporte." },
    { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Equipaciones personalizadas, calzado y material para fútbol, baloncesto, vóley, balonmano y mucho más, con las mejores marcas del mercado. Distribuidor oficial de Forelle en la Península, Baleares y Canarias." },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Diseña tu equipación" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "text", "id": "link_label", "label": "Enlace secundario", "default": "Presupuesto para tu club" },
    { "type": "url", "id": "link_url", "label": "URL del enlace secundario" },
    { "type": "header", "content": "Escenario" },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional)", "info": "Si añades una foto de equipo (2400×1400), sustituye a la composición de camisetas." },
    { "type": "text", "id": "chip_title", "label": "Sello 1: título", "default": "Distribuidor oficial Forelle" },
    { "type": "text", "id": "chip_text", "label": "Sello 1: texto", "default": "Península · Baleares · Canarias" },
    { "type": "text", "id": "chip2_big", "label": "Sello 2: cifra", "default": "100%" },
    { "type": "text", "id": "chip2_text", "label": "Sello 2: texto", "default": "Personalizable: colores, escudo y dorsales" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "7+" },
        { "type": "text", "id": "label", "label": "Texto", "default": "deportes" }
      ]
    }
  ],
  "presets": [ { "name": "Portada (hero)" } ]
}
{% endschema %}
