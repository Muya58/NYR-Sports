<section class="section" id="tienda">
  <header class="section__head section__head--row reveal">
    <div>
      {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="segmented" role="tablist" data-tabs aria-label="{{ 'collections.filter' | t }}">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="{% if forloop.first %}is-on{% endif %}" aria-selected="{{ forloop.first }}" data-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | escape }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </header>

  {%- for block in section.blocks -%}
    {%- assign c = block.settings.collection -%}
    <div class="tabpanel" data-panel="{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
      <div class="grid">
        {%- if c != blank and c.products_count > 0 -%}
          {%- for product in c.products limit: section.settings.limit -%}
            {% render 'product-card', product: product, show_quick_add: true %}
          {%- endfor -%}
        {%- else -%}
          <p class="muted empty-note">{{ 'collections.empty_setup' | t }}</p>
        {%- endif -%}
      </div>
      {%- if c != blank and c.products_count > section.settings.limit -%}
        <div class="center more"><a class="btn btn--ghost" href="{{ c.url }}">{{ 'collections.view_all' | t: count: c.products_count }}</a></div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Tienda por colecciones",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tienda" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Equipaciones y material." },
    { "type": "range", "id": "limit", "label": "Productos por pestaña", "min": 3, "max": 24, "step": 3, "default": 9 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Pestaña",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre de la pestaña" },
        { "type": "collection", "id": "collection", "label": "Colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tienda por colecciones",
      "blocks": [
        { "type": "collection", "settings": { "label": "Todo" } },
        { "type": "collection", "settings": { "label": "Fútbol" } },
        { "type": "collection", "settings": { "label": "F. americano" } },
        { "type": "collection", "settings": { "label": "Béisbol y softball" } }
      ]
    }
  ]
}
{% endschema %}
