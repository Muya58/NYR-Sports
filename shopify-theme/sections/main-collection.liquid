{%- paginate collection.products by section.settings.per_page -%}
<section class="section plp">
  <header class="plp__head">
    <nav class="crumbs" aria-label="{{ 'products.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank %}<div class="lead rte">{{ collection.description }}</div>{% endif -%}
  </header>

  <form class="plp__bar" data-filter-form>
    <div class="plp__filters">
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'list' -%}
          <details class="filter">
            <summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} <b>({{ filter.active_values.size }})</b>{% endif %}</summary>
            <div class="filter__menu">
              {%- for value in filter.values limit: 60 -%}
                <label class="check">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                  <span>{{ value.label | escape }}</span><small>{{ value.count }}</small>
                </label>
              {%- endfor -%}
            </div>
          </details>
        {%- elsif filter.type == 'price_range' -%}
          <details class="filter">
            <summary>{{ filter.label | escape }}</summary>
            <div class="filter__menu filter__menu--price">
              <label class="field"><span>{{ 'collections.min' | t }}</span><input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100 }}" min="0" placeholder="0"></label>
              <label class="field"><span>{{ 'collections.max' | t }}</span><input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100 }}" min="0" placeholder="{{ filter.range_max | divided_by: 100 }}"></label>
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {%- assign active = 0 -%}
      {%- for filter in collection.filters -%}{%- assign active = active | plus: filter.active_values.size -%}{%- endfor -%}
      {%- if active > 0 %}<a class="link" href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}">{{ 'collections.clear' | t }}</a>{% endif -%}
    </div>
    <label class="plp__sort">
      <span class="fine">{{ 'collections.sort' | t }}</span>
      <select name="sort_by" id="sort-{{ section.id }}">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </label>
  </form>

  <p class="fine plp__count">{{ 'collections.count' | t: count: collection.products_count }}</p>

  <div class="grid">
    {%- for product in collection.products -%}
      {% render 'product-card', product: product, show_quick_add: true %}
    {%- else -%}
      <p class="muted empty-note">{{ 'collections.empty' | t }}</p>
    {%- endfor -%}
  </div>

  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 12, "max": 48, "step": 6, "default": 24 }
  ]
}
{% endschema %}
