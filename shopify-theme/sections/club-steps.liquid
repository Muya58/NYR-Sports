<section class="section" id="clubes">
  <header class="section__head reveal">
    {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
    <h2>{{ section.settings.heading | escape }}<br><span class="muted">{{ section.settings.subheading | escape }}</span></h2>
  </header>
  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- assign tiers = section.blocks | where: 'type', 'tier' -%}
  {%- if steps.size > 0 -%}
    <ol class="steps steps--{{ steps.size }}">
      {%- for block in steps -%}
        <li class="reveal" {{ block.shopify_attributes }}><span class="steps__n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
  {%- if tiers.size > 0 -%}
    <div class="tiers reveal">
      {%- for block in tiers -%}
        <div class="tier{% if block.settings.highlight %} tier--hot{% endif %}" {{ block.shopify_attributes }}>
          <small>{{ block.settings.label | escape }}</small><b>{{ block.settings.value | escape }}</b>
          {%- if block.settings.badge != blank %}<em>{{ block.settings.badge | escape }}</em>{% endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.button_label != blank -%}
    <div class="center reveal"><a class="btn btn--navy" href="{{ section.settings.button_link | default: '#presupuesto' }}">{{ section.settings.button_label | escape }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Clubes y descuentos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para clubes, colegios y federaciones" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Equipar a todo un club" },
    { "type": "text", "id": "subheading", "label": "Subtitular", "default": "nunca fue tan sencillo." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Solicitar presupuesto" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    { "type": "step", "name": "Paso", "limit": 4, "settings": [
      { "type": "text", "id": "title", "label": "Título", "default": "Diseña" },
      { "type": "textarea", "id": "text", "label": "Texto", "default": "Configura colores, escudos y dorsales online o con nuestro equipo de diseño." }
    ] },
    { "type": "tier", "name": "Descuento", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Condición", "default": "15 – 29 uds." },
      { "type": "text", "id": "value", "label": "Valor", "default": "−10%" },
      { "type": "checkbox", "id": "highlight", "label": "Destacar", "default": false },
      { "type": "text", "id": "badge", "label": "Etiqueta" }
    ] }
  ],
  "presets": [
    {
      "name": "Clubes y descuentos",
      "blocks": [
        { "type": "step", "settings": { "title": "Diseña", "text": "Configura colores, escudos y dorsales online o con nuestro equipo de diseño." } },
        { "type": "step", "settings": { "title": "Aprueba", "text": "Te enviamos el boceto de cada prenda para tu visto bueno antes de producir." } },
        { "type": "step", "settings": { "title": "Fabricamos", "text": "Producción a medida con nuestras fábricas asociadas y control de calidad en cada lote." } },
        { "type": "step", "settings": { "title": "Recibe", "text": "Entrega embolsada por jugador, lista para el vestuario, en toda España." } },
        { "type": "tier", "settings": { "label": "15 – 29 uds.", "value": "−10%" } },
        { "type": "tier", "settings": { "label": "30 – 59 uds.", "value": "−15%" } },
        { "type": "tier", "settings": { "label": "60+ uds.", "value": "−22%", "highlight": true, "badge": "Más elegido" } },
        { "type": "tier", "settings": { "label": "Colegios", "value": "Tarifa edu" } }
      ]
    }
  ]
}
{% endschema %}
