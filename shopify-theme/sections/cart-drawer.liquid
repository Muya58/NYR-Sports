{%- comment -%}
  Bolsa lateral. Se re-renderiza con la Section Rendering API (?sections=cart-drawer)
  cada vez que cambia el carrito (ver assets/theme.js).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign left = threshold | minus: cart.total_price
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<div class="overlay overlay--side" id="cartOverlay" hidden>
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
    <header class="drawer__head">
      <h3 id="cartTitle">{{ 'cart.title' | t }}</h3>
      <button class="close" type="button" data-close aria-label="{{ 'general.close' | t }}">&times;</button>
    </header>

    {%- if threshold > 0 and cart.item_count > 0 -%}
      <div class="ship-meter">
        <p>
          {%- if left > 0 -%}
            {{ 'cart.free_shipping_left_html' | t: amount: left | money }}
          {%- else -%}
            <b>{{ 'cart.free_shipping_ok' | t }}</b>
          {%- endif -%}
        </p>
        <div><i style="width: {{ pct }}%"></i></div>
      </div>
    {%- endif -%}

    <ul class="cart-list">
      {%- for item in cart.items -%}
        <li class="line">
          <a class="line__art" href="{{ item.url }}">
            {%- if item.image -%}
              {{ item.image | image_url: width: 160 | image_tag: alt: item.product.title, loading: 'lazy' }}
            {%- else -%}
              {% render 'product-art', product: item.product, width: 160 %}
            {%- endif -%}
          </a>
          <div class="line__info">
            <b>{{ item.product.title | escape }}</b>
            {%- unless item.product.has_only_default_variant -%}<small>{{ item.variant.title | escape }}</small>{%- endunless -%}
            {%- for p in item.properties -%}
              {%- assign first = p.first | slice: 0 -%}
              {%- if p.last != blank and first != '_' -%}<small>{{ p.first }}: {{ p.last }}</small>{%- endif -%}
            {%- endfor -%}
            {%- for d in item.line_level_discount_allocations -%}
              <small class="save">{{ d.discount_application.title }} (−{{ d.amount | money }})</small>
            {%- endfor -%}
            <div class="line__ctl">
              <div class="qty qty--sm">
                <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t }}">−</button>
                <output>{{ item.quantity }}</output>
                <button type="button" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t }}">+</button>
              </div>
              <button type="button" class="link" data-line="{{ forloop.index }}" data-qty="0">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
          <b class="line__price">{{ item.final_line_price | money }}</b>
        </li>
      {%- else -%}
        <li class="empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="link-arrow">{{ 'cart.continue' | t }}</a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if cart.item_count > 0 -%}
      <footer class="drawer__foot">
        {%- for d in cart.cart_level_discount_applications -%}
          <div class="sum sum--sm"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="sum"><span>{{ 'cart.subtotal' | t }}</span><b>{{ cart.total_price | money }}</b></div>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="btn btn--lime btn--block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </form>
        <a class="link center" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a>
        <p class="fine center">{{ 'cart.taxes_note' | t }}</p>
      </footer>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{
  "name": "Bolsa lateral",
  "settings": []
}
{% endschema %}
