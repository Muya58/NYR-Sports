{%- comment -%}
  Configurador de equipaciones. Cada bloque «Deporte» se asocia a un producto de Shopify;
  al añadir, se envía su variante (talla) con la personalización como propiedades de línea,
  para que llegue a producción con el pedido.
{%- endcomment -%}
{%- assign palette_a = section.settings.palette_a | split: ',' -%}
{%- assign palette_b = section.settings.palette_b | split: ',' -%}
<section class="section section--soft" id="personaliza">
  <header class="section__head reveal">
    {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- if section.settings.text != blank %}<p class="lead">{{ section.settings.text }}</p>{% endif -%}
  </header>

  {%- liquid
    assign quote = settings.hide_prices
  -%}
  <div class="config reveal" data-configurator data-min="{{ section.settings.min_qty }}" data-quote="{{ quote }}" data-quote-url="{{ settings.quote_url }}" data-quote-label="{{ 'products.request_price' | t }}" data-quote-price="{{ 'products.price_on_request' | t }}">
    <div class="config__preview">
      <div class="segmented segmented--float" role="tablist" aria-label="{{ 'config.sport' | t }}">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="{% if forloop.first %}is-on{% endif %}" data-sport="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
        {%- endfor -%}
      </div>
      <div class="config__art" data-config-art></div>
      <p class="config__caption" data-config-caption></p>
    </div>

    <form class="config__panel" data-config-form>
      <fieldset>
        <legend>{{ 'config.main_color' | t }}</legend>
        <div class="swatches" data-target="a">
          {%- for c in palette_a -%}
            {%- assign kv = c | split: ':' -%}
            <button type="button" style="--c:{{ kv[1] | strip }}" data-c="{{ kv[1] | strip }}" data-n="{{ kv[0] | strip }}" aria-label="{{ kv[0] | strip }}" class="{% if forloop.first %}is-on{% endif %}"></button>
          {%- endfor -%}
        </div>
      </fieldset>
      <fieldset>
        <legend>{{ 'config.detail_color' | t }}</legend>
        <div class="swatches" data-target="b">
          {%- for c in palette_b -%}
            {%- assign kv = c | split: ':' -%}
            <button type="button" style="--c:{{ kv[1] | strip }}" data-c="{{ kv[1] | strip }}" data-n="{{ kv[0] | strip }}" aria-label="{{ kv[0] | strip }}" class="{% if forloop.first %}is-on{% endif %}"></button>
          {%- endfor -%}
        </div>
      </fieldset>
      <div class="row">
        <label class="field"><span>{{ 'config.number' | t }}</span><input name="num" id="cfgNum-{{ section.id }}" inputmode="numeric" maxlength="2" value="10"></label>
        <label class="field"><span>{{ 'config.kit' | t }}</span>
          <select name="kit" id="cfgKit-{{ section.id }}">
            {%- assign kits = section.settings.kits | split: ',' -%}
            {%- for k in kits %}<option>{{ k | strip }}</option>{% endfor -%}
          </select>
        </label>
      </div>
      <div class="row">
        <label class="field"><span>{{ 'config.size' | t }}</span><select name="variant" id="cfgSize-{{ section.id }}" data-config-size></select></label>
        <label class="field"><span>{{ 'config.qty' | t }}</span><input name="qty" id="cfgQty-{{ section.id }}" type="number" min="1" value="{{ section.settings.min_qty }}" inputmode="numeric"></label>
      </div>
      <label class="field"><span>{{ 'config.team' | t }}</span><input name="team" id="cfgTeam-{{ section.id }}" maxlength="18" placeholder="{{ 'config.team_placeholder' | t }}"></label>
      <div class="config__foot">
        <div><small>{{ 'products.from' | t }}</small> <b class="price" data-config-price>—</b><small>{{ 'config.per_unit' | t }}</small></div>
        <button class="btn btn--lime" type="submit" data-config-add>{{ 'config.add' | t }}</button>
      </div>
      <p class="fine" data-config-note hidden>{{ 'config.no_product' | t }}</p>
    </form>
  </div>

  <script type="application/json" data-config-data>
    [
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {
          "label": {{ block.settings.label | json }},
          "garment": {{ block.settings.garment | json }},
          "product": {% if p != blank %}{{ p.title | json }}{% else %}null{% endif %},
          "variants": [
            {%- if p != blank -%}
              {%- for v in p.variants -%}
                { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }}, "price": {{ v.price | money | json }} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            {%- endif -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Configurador",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Equipos, clubes y colegios" },
    { "type": "textarea", "id": "heading", "label": "Titular", "default": "Tu equipación,\ndiseñada en directo." },
    { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Elige deporte y colores, añade dorsal y nombre del equipo. Sublimación de alta definición en tejidos técnicos transpirables." },
    { "type": "text", "id": "palette_a", "label": "Colores principales", "default": "Navy:#01144C, Lima:#B8FC0B, Granate:#B3122E, Blanco:#F5F5F7, Negro:#1D1D1F, Royal:#1F6FEB, Verde:#0E8A4F", "info": "Nombre:#hex separados por comas." },
    { "type": "text", "id": "palette_b", "label": "Colores de detalle", "default": "Lima:#B8FC0B, Blanco:#F5F5F7, Oro:#D4A72C, Navy:#01144C, Granate:#B3122E" },
    { "type": "text", "id": "kits", "label": "Tipos de equipación", "default": "Primera, Segunda, Entrenamiento" },
    { "type": "number", "id": "min_qty", "label": "Cantidad inicial", "default": 15 }
  ],
  "blocks": [
    {
      "type": "sport",
      "name": "Deporte",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Fútbol" },
        { "type": "product", "id": "product", "label": "Producto que se añade al pedido" },
        { "type": "select", "id": "garment", "label": "Prenda", "default": "soccer", "options": [
          { "value": "soccer", "label": "Camiseta (fútbol, vóley, balonmano)" },
          { "value": "tank", "label": "Camiseta sin mangas (baloncesto)" },
          { "value": "football", "label": "Jersey de fútbol americano" },
          { "value": "baseball", "label": "Camiseta de béisbol" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Configurador",
      "blocks": [
        { "type": "sport", "settings": { "label": "Fútbol", "garment": "soccer" } },
        { "type": "sport", "settings": { "label": "Baloncesto", "garment": "tank" } },
        { "type": "sport", "settings": { "label": "Vóley", "garment": "soccer" } },
        { "type": "sport", "settings": { "label": "Balonmano", "garment": "soccer" } },
        { "type": "sport", "settings": { "label": "F. americano", "garment": "football" } },
        { "type": "sport", "settings": { "label": "Béisbol", "garment": "baseball" } }
      ]
    }
  ]
}
{% endschema %}
