{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current = product.selected_or_first_available_variant
  assign quote = false
  if settings.hide_prices or product.price_max == 0
    assign quote = true
  endif
  assign personalizable = false
  if product.tags contains 'personalizable'
    assign personalizable = true
  endif
-%}
<section class="section pdp" data-product-section>
  <nav class="crumbs" aria-label="{{ 'products.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    {%- if collection %}<span>/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endif -%}
    <span>/</span><span aria-current="page">{{ product.title | escape }}</span>
  </nav>

  <div class="pdp__grid">
    <div class="pdp__media">
      <div class="pdp__main" data-main-media>
        {% render 'product-art', product: product, width: 1200, sizes: '(min-width: 900px) 55vw, 92vw' %}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for media in product.media limit: 10 -%}
            <button type="button" class="pdp__thumb{% if forloop.first %} is-on{% endif %}" data-thumb="{{ media | image_url: width: 1200 }}" aria-label="{{ 'products.view_image' | t: n: forloop.index }}">
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      {%- if product.vendor != blank -%}
        <p class="eyebrow">{{ product.vendor | escape }}{% if product.tags contains 'forelle' %} · {{ 'products.forelle' | t }}{% endif %}</p>
      {%- endif -%}
      <h1 class="pdp__title">{{ product.title | escape }}</h1>
      {%- if quote -%}
        <p class="pdp__price"><span class="price-quote">{{ 'products.price_on_request' | t }}</span></p>
        <p class="fine">{{ 'products.price_on_request_note' | t }}</p>
      {%- else -%}
        <p class="pdp__price" data-price>
          {%- if current.compare_at_price > current.price %}<s class="muted">{{ current.compare_at_price | money }}</s> {% endif -%}
          {{ current.price | money }}
        </p>
        <p class="fine">{{ 'products.tax_included' | t }}</p>
      {%- endif -%}

      {%- form 'product', product, id: product_form_id, class: 'pdp__form', data-product-form: '', data-quote: quote, data-quote-url: settings.quote_url -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt">
              <legend class="opt-label">{{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend>
              <div class="sizes" role="radiogroup">
                {%- for value in option.values -%}
                  <label class="pill">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                    <span>{{ value | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {%- if personalizable -%}
          <div class="row">
            <label class="field"><span>{{ 'products.number' | t }}</span><input name="properties[Dorsal]" id="pNum-{{ section.id }}" inputmode="numeric" maxlength="2" placeholder="00"></label>
            <label class="field"><span>{{ 'products.back_name' | t }}</span><input name="properties[Nombre]" id="pName-{{ section.id }}" maxlength="14" placeholder="{{ 'products.optional' | t }}"></label>
          </div>
          <p class="fine">{{ 'products.volume_note' | t }}</p>
        {%- endif -%}

        <div class="qty-row">
          <div class="qty" data-qty-box>
            <button type="button" data-step="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}" id="pQty-{{ section.id }}">
            <button type="button" data-step="1" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
          {%- if quote -%}
            <button type="submit" class="btn btn--lime btn--grow" data-quote-btn>{{ 'products.request_price' | t }}</button>
          {%- else -%}
          <button type="submit" class="btn btn--lime btn--grow" data-add-btn data-label-add="{{ 'products.add_to_cart' | t }}" data-label-sold="{{ 'products.sold_out' | t }}" {% unless current.available %}disabled{% endunless %}>
            {%- if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif -%}
          </button>
          {%- endif -%}
        </div>
        <p class="err" data-form-error hidden></p>
      {%- endform -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="perks">{%- for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endfor -%}</ul>
      {%- endif -%}

      {%- if product.description != blank -%}
        <details class="pdp__desc" open>
          <summary>{{ 'products.description' | t }}</summary>
          <div class="rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-variants>
    [
      {%- for v in product.variants -%}
        { "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "price": {{ v.price | money | json }}, "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %}, "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
    "offers": [
      {%- for v in product.variants -%}
        { "@type": "Offer", "sku": {{ v.sku | json }}, "price": {{ v.price | divided_by: 100.0 | json }}, "priceCurrency": {{ cart.currency.iso_code | json }}, "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}", "url": {{ request.origin | append: v.url | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Ficha de producto",
  "blocks": [
    { "type": "perk", "name": "Ventaja", "settings": [ { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis desde 150 €" } ] }
  ]
}
{% endschema %}
