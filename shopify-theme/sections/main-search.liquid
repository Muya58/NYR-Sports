{%- paginate search.results by 24 -%}
<section class="section plp">
  <header class="plp__head">
    <h1>{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="searchpage">
      <input type="search" name="q" id="searchPage" value="{{ search.terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}" aria-label="{{ 'header.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button class="btn btn--navy">{{ 'header.search' | t }}</button>
    </form>
    {%- if search.performed %}<p class="fine">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>{% endif -%}
  </header>
  <div class="grid">
    {%- for item in search.results -%}
      {%- if item.object_type == 'product' -%}
        {% render 'product-card', product: item, show_quick_add: true %}
      {%- else -%}
        <article class="product"><div class="product__info"><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3></div></article>
      {%- endif -%}
    {%- else -%}
      {%- if search.performed %}<p class="muted empty-note">{{ 'search.none' | t }}</p>{% endif -%}
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Búsqueda" }
{% endschema %}
