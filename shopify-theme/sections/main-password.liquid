<section class="section page center password">
  <img src="{{ 'nyr-icon.svg' | asset_url }}" alt="" width="72" height="72">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank %}<p class="lead" style="margin: 12px auto 24px">{{ shop.password_message }}</p>{% endif -%}
  {%- form 'storefront_password', class: 'searchpage' -%}
    <input type="password" name="password" id="pw" placeholder="{{ 'password.placeholder' | t }}" aria-label="{{ 'password.placeholder' | t }}">
    <button class="btn btn--navy">{{ 'password.enter' | t }}</button>
    {%- if form.errors %}<p class="err">{{ form.errors | default_errors }}</p>{% endif -%}
  {%- endform -%}
</section>
{% schema %}
{ "name": "Contraseña" }
{% endschema %}
